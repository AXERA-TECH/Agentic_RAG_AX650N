# ============ LLM/VLM 服务 ============
DEFAULT_PROVIDER=local
# 后端打印每次 LLM 调用的完整原始响应，调试时开启。
LLM_DEBUG=false
LLM_PROVIDERS__LOCAL__API_BASE=http://192.168.1.100:8009/v1
LLM_PROVIDERS__LOCAL__API_KEY=not-needed
LLM_PROVIDERS__LOCAL__MODEL=your-chat-model
LLM_PROVIDERS__LOCAL__VISION_MODEL=your-vision-model
LLM_PROVIDERS__LOCAL__MAX_TOKENS=4096
LLM_PROVIDERS__LOCAL__TEMPERATURE=0.7
# 调试阶段同时启用 native tool calling，并保留文本 Thought/Action 兼容解析。
LLM_PROVIDERS__LOCAL__ENABLE_NATIVE_TOOL_CALLS=true
# 模型总上下文窗口（prompt + output），必须与推理服务的 max_model_len 一致。
# 历史预算 = context_window - 输出/系统/证据预留，由 ContextBuilder 使用。
LLM_PROVIDERS__LOCAL__CONTEXT_WINDOW=16384

# ============ 会话上下文管理 ============
# 超过高水位触发一次摘要重建；一次淘汰到低水位以下，避免每轮重建。
MEMORY__HIGH_WATERMARK=0.90
MEMORY__LOW_WATERMARK=0.55
MEMORY__BLOCK_TURNS=4
MEMORY__MIN_RECENT_TURNS=2
MEMORY__SUMMARY_MAX_TOKENS=600

# ============ Agent 路由与有界检索 ============
# 确定性规则先判定 DIRECT / SEARCH / ACTION；只有复杂的 SEARCH 才调用 LLM 规划器。
# 路由 profile：strict_kb / balanced / general。
AGENT__ROUTING_PROFILE=balanced
# 简单检索走单工具确定性路径；复杂、多跳和附件请求仍使用 ReAct。
AGENT__SIMPLE_KB_SINGLE_PASS=true
AGENT__PLANNER_ENABLED=true
AGENT__PLANNER_TIMEOUT_SECONDS=12
# 每轮检索总次数上限（确定性首轮计入 1 次）。
AGENT__MAX_RETRIEVAL_ROUNDS=2
# 复杂请求在 Final Answer 前执行证据充分性检查。
AGENT__SUFFICIENCY_CHECK_ENABLED=true
# MCP 工具超过上限时，按本轮查询筛选后仅暴露少量相关工具。
AGENT__TOOL_SELECTION_ENABLED=true
AGENT__MAX_MCP_TOOLS=5

# ============ 可选：Langfuse LLM 追踪 ============
# 在 Langfuse 项目设置中创建 API keys；未配置密钥时自动禁用追踪。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=agentic-rag@0.1.0
LANGFUSE_SAMPLE_RATE=1.0

# ============ Embedding 服务 ============
EMBEDDING__PROVIDER=local
EMBEDDING__API_BASE=http://192.168.1.100:8010/v1
EMBEDDING__API_KEY=not-needed
EMBEDDING__MODEL=AXERA-TECH/jina-embeddings-v5-omni-nano-retrieval-AX650-P128-CTX2047
EMBEDDING__MODEL_TYPE=multimodal
EMBEDDING__DIM=768
EMBEDDING__BATCH_SIZE=4

# Milvus Lite 的向量维度必须与 Embedding 输出一致
MILVUS__DIM=768

# ============ 可选：SenseVoice STT ============
VOICE__STT_PROVIDER=sensevoice
VOICE__STT_MODEL=sensevoice
VOICE__STT_API_BASE=http://192.168.1.100:8011
VOICE__STT_LANGUAGE=auto
VOICE__SAMPLE_RATE=16000

# ============ 可选：Kokoro TTS ============
VOICE__TTS_PROVIDER=kokoro
VOICE__TTS_MODEL=kokoro
VOICE__TTS_API_BASE=http://192.168.1.100:8012
VOICE__TTS_LANGUAGE=zh
VOICE__TTS_VOICE=zf_xiaoyi
VOICE__TTS_SPEED=1.0
VOICE__TTS_RESPONSE_FORMAT=wav

# ============ 可选：PaddleOCR-VL ============
# 默认留空，文档优先使用 Docling；配置为 ocr 等非空值后才启用 OCR。
OCR__MODE=
OCR__ENABLED=true
OCR__API_BASE=http://192.168.1.100:8013/v1
OCR__MODEL=PaddlePaddle/PaddleOCR-VL
OCR__API_KEY=not-needed
OCR__MAX_PAGES=50

# ============ Agentic RAG Web 服务 ============
# 默认仅监听本机；如需局域网/容器访问改成 0.0.0.0 并配置 API__API_KEY。
API__HOST=127.0.0.1
API__PORT=8007
# 设置后所有 /api/* 请求需携带 X-API-Key 或 Authorization: Bearer <key>
API__API_KEY=
# 上传文件大小上限（字节，默认 50 MiB）
API__MAX_UPLOAD_BYTES=52428800
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
